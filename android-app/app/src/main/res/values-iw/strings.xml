    <!-- ===== הסכמה ===== -->
    <string name="consent_title">אישור ניטור דופק</string>
    <string name="consent_intro">כדי לזהות התקפי חרדה מוקדם, קאלם‑סנס צריך לקרוא נתוני חיישנים מהשעון שלכם. הנה בדיוק מה ולמה:</string>
    <string name="consent_what_title">דופק ומרווחים בין פעימות (IBI)</string>
    <string name="consent_what_desc">ברציפות, כל עוד אתם עונדים את השעון — כדי למדוד שונות בקצב הלב (HRV).</string>
    <string name="consent_why_title">משמש רק לזיהוי התקף חרדה</string>
    <string name="consent_why_desc">דופק גבוה יחד עם HRV נמוך הוא סימן מוקדם. נתוני התנועה מבחינים בין התקף חרדה למאמץ גופני.</string>
    <string name="consent_where_title">מעובד במכשירים שלכם</string>
    <string name="consent_where_desc">הניתוח מתבצע בשעון ובטלפון שלכם. אפשר להפסיק את הניטור בכל רגע דרך ההגדרות.</string>
    <string name="consent_disclaimer">בהמשך אתם מסכימים לכך שקאלם‑סנס יקרא את נתוני הדופק וה‑HRV שלכם לצורך זיהוי התקפי חרדה. קאלם‑סנס אינו מכשיר רפואי.</string>
    <string name="consent_accept">אני מסכים — התחילו בניטור</string>
    <string name="consent_decline">לא עכשיו</string>

