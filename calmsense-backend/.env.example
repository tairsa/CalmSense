# Copy this file to ".env" and fill in your Supabase project values.
# Find these in your Supabase dashboard: Project Settings -> API.
#
#   Project URL   -> SUPABASE_URL
#   API key       -> SUPABASE_KEY
#
# For local/server backend use the "service_role" key (full read/write,
# bypasses Row Level Security). Keep it SECRET - never commit the real .env
# and never ship the service_role key in the Android app.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_KEY=your-service-role-key-here

# --- Admin web app -----------------------------------------------------------
# Secret used to sign admin JWTs. Set a long random value in production so
# tokens stay valid across restarts. If unset, a random per-process secret is
# used (logins reset every restart). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=

# How long an admin login stays valid, in hours (default 12).
# ADMIN_JWT_EXPIRE_HOURS=12

# Comma-separated browser origins allowed to call the API (the admin app).
# Defaults to the Vite dev server. Add your deployed admin-app URL here.
# ADMIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Therapist access from the phone app ---------------------------------------
# The Android app authenticates against Supabase, so a therapist arrives with a
# Supabase-signed JWT rather than an admin one. Set this to verify those tokens
# and allow therapist/developer accounts to read GET /api/v1/admin/users and
# GET /api/v1/admin/users/{id}/reports.
#
# Find it in Supabase: Project Settings -> API -> JWT Secret.
#
# Leave BLANK to disable therapist access entirely - those endpoints then stay
# admin-only. An unset secret never means "accept unverified tokens".
SUPABASE_JWT_SECRET=

# --- Model training ----------------------------------------------------------
# Minimum labeled feedback rows (with both classes) required to retrain a user
# model. Lower it for small demos. Default 10.
# CALMSENSE_MIN_TRAIN_SAMPLES=10

# Minutes between automatic retraining passes. Each pass retrains every user
# who has enough new labeled feedback since their last training. 0 disables
# the loop (manual retrain via the admin app still works). Default 60.
# CALMSENSE_AUTO_RETRAIN_MINUTES=60
