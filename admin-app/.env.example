# Admin web app configuration. Copy to `.env` and adjust as needed.

# Backend the Vite dev server proxies /api to. Defaults to http://localhost:8000.
VITE_BACKEND_URL=http://localhost:8000

# Optional: call an absolute backend URL instead of the dev proxy (e.g. in a
# built/deployed app). Leave unset to use the same-origin proxy in dev.
# VITE_API_BASE=https://api.example.com
